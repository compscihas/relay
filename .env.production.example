# Copy this file to .env on the backend server and replace both secrets.
POSTGRES_USER=relay
POSTGRES_DB=relay
POSTGRES_PASSWORD=replace-with-a-random-hex-secret
JWT_SECRET=replace-with-a-different-random-hex-secret
CLOUDFLARED_TUNNEL_TOKEN=paste-the-private-cloudflare-tunnel-token

# The API binds to loopback so a TLS reverse proxy can expose it safely.
PORT=3000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
LOG_LEVEL=info
