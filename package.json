{
  "name": "relay-multiplayer",
  "version": "0.1.0",
  "private": true,
  "description": "The multiplayer layer for JIT software.",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @relay/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @relay/api",
    "db:migrate": "npm run db:migrate --workspace @relay/api",
    "start": "npm run start --workspace @relay/api",
    "relay": "npm run relay --workspace @relay/cli --"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

